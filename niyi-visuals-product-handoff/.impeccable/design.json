  "components": [
    {
      "name": "Primary destination action",
      "kind": "button",
      "refersTo": "action-primary",
      "description": "Homepage work/inquiry link; destination semantics remain an anchor.",
      "html": "<a class=\"ds-action ds-primary\" href=\"/portfolio/\"><span>View work</span><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"M5 19 19 5M5 5h14v14\" /></svg></a>",
      "css": ".ds-action{display:inline-flex;align-items:center;justify-content:space-between;gap:28px;min-height:48px;font:500 16px/1.6 var(--font-sans);text-decoration:none;}.ds-primary{padding:12px 22px;border:1px solid var(--accent);border-radius:2px;background:var(--accent);color:var(--ink);transition:background-color 160ms,color 160ms,transform 120ms}.ds-primary:hover{background:var(--accent-hover);border-color:var(--accent-hover)}.ds-primary:focus-visible{outline:2px solid var(--focus-dark);outline-offset:5px;}@media(prefers-reduced-motion:no-preference){.ds-primary:active{transform:translateY(1px)}}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}.ds-action svg{flex:none;transform:rotate(45deg)}"
    },
    {
      "name": "Text destination action",
      "kind": "button",
      "refersTo": "action-text",
      "description": "Quiet related-page action with a persistent underline.",
      "html": "<a class=\"ds-action ds-text\" href=\"/portfolio/\"><span>View all work</span><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"M5 19 19 5M5 5h14v14\" /></svg></a>",
      "css": ".ds-action{display:inline-flex;align-items:center;justify-content:space-between;gap:28px;min-height:48px;font:500 16px/1.6 var(--font-sans);text-decoration:none;}.ds-text{color:var(--paper)}.ds-text span{text-decoration:underline;text-underline-offset:6px;text-decoration-thickness:1px;text-decoration-color:var(--control-border-dark);transition:text-decoration-color 160ms}.ds-text:hover span{text-decoration-color:currentColor}.ds-text:focus-visible{outline:2px solid var(--focus-dark);outline-offset:5px;}@media(prefers-reduced-motion:reduce){.ds-text span{transition:none}}.ds-action svg{flex:none;transform:rotate(45deg)}"
    },
    {
      "name": "Contact navigation link",
      "kind": "nav",
      "refersTo": "nav-contact",
      "description": "Outlined desktop navigation action; quiet inversion on hover.",
      "html": "<a class=\"ds-contact\" href=\"/contact/\">Contact<svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"M5 19 19 5M5 5h14v14\" /></svg></a>",
      "css": ".ds-contact{display:inline-flex;align-items:center;gap:28px;padding:10px 16px;border:1px solid var(--control-border-dark);border-radius:2px;font:400 15px/1.6 var(--font-sans);color:var(--paper);text-decoration:none;transition:background-color 160ms,color 160ms}.ds-contact:hover{background:var(--paper);color:var(--ink)}.ds-contact:focus-visible{outline:2px solid var(--focus-dark);outline-offset:5px;}@media(prefers-reduced-motion:reduce){.ds-contact{transition:none}}"
    },
    {
      "name": "Work category disclosure surface",
      "kind": "nav",
      "refersTo": "work-categories",
      "description": "Expanded-state visual of the independent Work category list; production behavior lives in interactions.ts.",
      "html": "<nav class=\"ds-categories\" aria-label=\"Photography categories\"><a href=\"/gallery-1/\">Sport</a><a href=\"/gallery-2/\">Parties</a><a href=\"/gallery-3/\">Lifestyle</a></nav>",
      "css": ".ds-categories{min-width:190px;padding:12px;border:1px solid var(--control-border-dark);background:var(--surface-dark);color:var(--paper);font:400 16px/1.6 var(--font-sans)}.ds-categories a{display:block;padding:12px;color:inherit}.ds-categories a:hover{background:var(--ink);text-decoration:underline;text-underline-offset:5px}.ds-categories a:focus-visible{outline:2px solid var(--focus-dark);outline-offset:5px;}"
    },
    {
      "name": "Service destination row",
      "kind": "custom",
      "refersTo": "service-arrow",
      "description": "A full linked row with title, description and outlined arrow.",
      "html": "<a class=\"ds-service\" href=\"/services/#sport\"><h3>Sport</h3><p>Match action, feeling and atmosphere.</p><span class=\"ds-service-arrow\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"M5 19 19 5M5 5h14v14\" /></svg></span></a>",
      "css": ".ds-service{display:grid;grid-template-columns:3fr 5fr 44px;align-items:center;gap:24px;min-height:132px;padding:26px 0;border-bottom:1px solid var(--rule-decorative);color:var(--paper);font-family:var(--font-sans);text-decoration:none}.ds-service h3{margin:0;font-size:clamp(24px,2.2vw,32px);font-weight:600;line-height:1.2;letter-spacing:-.015em}.ds-service p{margin:0;max-width:25ch;font-size:18px;line-height:1.6;color:var(--text-muted-dark)}.ds-service-arrow{display:grid;place-items:center;width:44px;height:44px;border:1px solid var(--control-border-dark);border-radius:2px;transition:color 160ms,background-color 160ms}.ds-service:hover .ds-service-arrow{background:var(--accent);color:var(--ink)}.ds-service:hover h3{text-decoration:underline;text-underline-offset:6px;text-decoration-thickness:1px}.ds-service:focus-visible{outline:2px solid var(--focus-dark);outline-offset:5px;}@media(max-width:767px){.ds-service{grid-template-columns:1fr 44px;gap:8px 20px;min-height:0;padding:24px 0}.ds-service p{grid-column:1;font-size:17px}.ds-service-arrow{grid-column:2;grid-row:1/3}}@media(prefers-reduced-motion:reduce){.ds-service-arrow{transition:none}}"
    },
    {
      "name": "Mobile navigation contents",
      "kind": "nav",
      "description": "The native dialog’s visual contents only; this panel snippet does not implement modal behavior.",
      "html": "<nav class=\"ds-mobile\" aria-label=\"Mobile navigation preview\"><a href=\"/\" aria-current=\"page\">Home</a><a href=\"/portfolio/\">Work</a><a href=\"/services/\">Services</a><a href=\"/about/\">About</a><a href=\"/contact/\">Contact</a></nav>",
      "css": ".ds-mobile{display:flex;flex-direction:column;align-items:start;gap:4px;padding:32px 20px;background:var(--surface-dark);color:var(--paper);font-family:var(--font-sans)}.ds-mobile a{padding:6px 0;font-size:clamp(30px,8vw,44px);line-height:1.3;letter-spacing:-.025em;color:inherit;text-decoration:none}.ds-mobile a[aria-current]{color:var(--text-muted-dark)}.ds-mobile a:hover{text-decoration:underline;text-underline-offset:8px}.ds-mobile a:focus-visible{outline:2px solid var(--focus-dark);outline-offset:5px;}"
    }
  ],
  "narrative": {
    "northStar": "On Both Sides",
    "overview": "On Both Sides retains the client’s photography, ink/paper palette, restrained coral actions and Plus Jakarta Sans voice while the homepage uses a new wide typographic opening, a separate landscape celebration image, a leading Sport image/category spread, and a warm-paper biography chapter. This revision responds to the user’s request for greater distinction from the original Pixieset site. Homepage only; no viewer, contact form or other pages are implemented.",
    "keyCharacteristics": [
      "Wide action/emotion typography above real landscape photography.",
      "Contrasting work-image proportions with a prominent Sport caption.",
      "A warm-paper reading chapter within the dark photographic site."
    ],
    "rules": [
      {
        "name": "The Photographic Color Rule",
        "body": "Preserve the registered photographs’ original color or monochrome treatment; large surfaces remain neutral; coral identifies actions and small directional details.",
        "section": "colors"
      },
      {
        "name": "The Reading Voice Rule",
        "body": "Use Plus Jakarta Sans for prose and UI; reserve Roboto Mono for short metadata.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Separate regions with tone, spacing and fine rules; do not introduce decorative shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve photograph identity, meaningful alt text, reserved geometry and the recorded focal positions.",
      "Do keep linked image, full category name and action together as one destination.",
      "Do retain the 18px tablet/desktop and 17px mobile prose roles, with the larger biography introduction distinct.",
      "Do keep content visible before enhancement and make reduced motion static.",
      "Do use destination links and state-changing buttons with visible keyboard focus."
    ],
    "donts": [
      "Don’t substitute stock or generated portfolio photographs, invented logos or business claims.",
      "Don’t turn the work sequence into three uniform cards or put long prose in tracked mono.",
      "Don’t place readable content behind photographic overlays or depend on hover alone.",
      "Don’t infer a separately implemented paper-themed page, viewer, inquiry form, hosting service, CMS or production origin from this homepage record."
    ]
  }
}
