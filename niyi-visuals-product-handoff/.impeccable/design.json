  "narrative": {
    "northStar": "On Both Sides",
    "overview": "On Both Sides gives the client’s photography the greatest visual weight. Ink grounds, warm paper text, variable Archivo, sparse mono metadata, rectangular images and fine rules produce a confident, human editorial system. Color comes primarily from the registered photographs; interface ornament remains quiet.\n\nThis record describes the built homepage and shared foundation only. It is evidence for local homepage review, not a claim that the remaining pages, a viewer, a contact form or production integrations exist. The pinned direction is already selected; this document records its implementation.",
    "keyCharacteristics": [
      "Real photography leads; text stays on a solid ground.",
      "Asymmetric image scale with continuous readable prose.",
      "Quiet links, thin rules and restrained state feedback."
    ],
    "rules": [
      {
        "name": "The Photographic Color Rule",
        "body": "Preserve the registered photographs’ original color or monochrome treatment; the interface stays neutral.",
        "section": "colors"
      },
      {
        "name": "The Reading Voice Rule",
        "body": "Use Archivo for prose and UI; reserve Roboto Mono for short metadata.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Separate regions with tone, spacing and fine rules; do not introduce decorative shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve photograph identity, meaningful alt text, reserved geometry and the recorded focal positions.",
      "Do keep linked image, full category name and action together as one destination.",
      "Do retain the 18px tablet/desktop and 17px mobile prose roles, with the larger biography introduction distinct.",
      "Do keep content visible before enhancement and make reduced motion static.",
      "Do use destination links and state-changing buttons with visible keyboard focus."
    ],
    "donts": [
      "Don’t substitute stock or generated portfolio photographs, invented logos or business claims.",
      "Don’t turn the work sequence into three uniform cards or put long prose in tracked mono.",
      "Don’t place readable content behind photographic overlays or depend on hover alone.",
      "Don’t infer a paper-themed page, viewer, inquiry form, hosting service, CMS or production origin from this homepage record."
    ]
  }
}
