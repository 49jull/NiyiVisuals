---
import { categories, routes } from '../content/site';
interface Props { id: string; }
const { id } = Astro.props;
---
<div class="work-navigation" data-work-disclosure>
  <a href={routes.work}>Work</a>
  <button class="work-toggle" type="button" aria-label="Open work categories" aria-expanded="false" aria-controls={id} data-work-toggle><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg></button>
  <ul id={id} class="work-categories" hidden>{categories.map(category => <li><a href={category.route}>{category.name}</a></li>)}</ul>
</div>
<style>
  .work-navigation { position: relative; display: flex; align-items: center; }
  .work-navigation > a { padding-block: 14px; }
  .work-toggle { display: grid; place-items: center; width: 44px; height: 48px; padding: 0; color: inherit; background: none; border: 0; cursor: pointer; }
  .work-toggle svg { transition: transform 180ms var(--ease-out); }
  .work-toggle[aria-expanded='true'] svg { transform: rotate(180deg); }
  .work-categories { position: absolute; z-index: 2; top: 100%; left: -20px; min-width: 190px; padding: 12px; border: 1px solid var(--control-border-dark); background: var(--surface-dark); list-style: none; }
  .work-categories a { display: block; padding: 12px; font-size: 16px; }
  .work-categories a:hover { background: var(--ink); text-decoration: underline; text-underline-offset: 5px; }
</style>
