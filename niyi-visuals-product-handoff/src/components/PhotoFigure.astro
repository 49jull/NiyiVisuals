---
import { Picture } from 'astro:assets';
import type { Photo } from '../content/photos';
interface Props { photo: Photo; class?: string; sizes?: string; eager?: boolean; caption?: string; }
const { photo, class: className, sizes = '(max-width: 767px) calc(100vw - 40px), 55vw', eager = false, caption } = Astro.props;
const widths = [480, 768, 1280, 1920].filter(width => width <= photo.src.width);
---
<figure class:list={['photo', className]} style={`--focal:${photo.focal};--mobile-focal:${photo.mobileFocal}`} data-photo-id={photo.id}>
  <div class="photo__frame">
    <Picture src={photo.src} alt={photo.alt} formats={['webp']} fallbackFormat="jpg" widths={widths} sizes={sizes} quality={83} loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : 'auto'} />
    <span class="photo__failure" hidden>{photo.alt} <span>Photograph unavailable.</span></span>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
<style>
  .photo { margin: 0; min-width: 0; }
  .photo__frame { position: relative; overflow: hidden; background: var(--surface-dark); }
  .photo :global(picture) { display: block; width: 100%; height: 100%; }
  .photo :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; object-position: var(--focal); }
  figcaption { margin-top: 14px; font: 400 12px/1.45 var(--font-mono); color: var(--text-muted-dark); }
  .photo__failure { position: absolute; inset: 0; padding: 24px; display: flex; flex-direction: column; justify-content: center; gap: 12px; color: var(--paper); background: var(--surface-dark); }
  .photo__failure[hidden] { display: none; }
  .photo__failure span { color: var(--text-muted-dark); font-size: 14px; }
  @media (max-width: 767px) { .photo :global(img) { object-position: var(--mobile-focal); } }
</style>
