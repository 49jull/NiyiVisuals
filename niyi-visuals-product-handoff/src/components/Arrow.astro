---
interface Props { direction?: 'right' | 'diagonal' | 'down'; }
const { direction = 'diagonal' } = Astro.props;
---
<svg class:list={['arrow', `arrow--${direction}`]} width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" /></svg>
<style>
  .arrow { flex: none; }
  .arrow--right { transform: rotate(45deg); }
  .arrow--down { transform: rotate(135deg); }
</style>
