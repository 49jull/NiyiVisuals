---
import { navigation, categories, contact } from '../content/site';
import Arrow from './Arrow.astro';
---
<footer class="site-footer container">
  <div class="footer-main">
    <div class="footer-identity"><a href="/" class="footer-name">Niyi Scholten</a><p>Photography<br />Apeldoorn, The Netherlands</p></div>
    <nav aria-label="Footer navigation"><a href="/" aria-current="page">Home</a>{navigation.map(item => <a href={item.href}>{item.label}</a>)}</nav>
    <nav aria-label="Photography categories">{categories.map(category => <a href={category.route}>{category.name}</a>)}</nav>
    <div class="footer-contact"><a href={`mailto:${contact.email}`}>{contact.email}<Arrow /></a><a href={contact.telephoneUri}>{contact.phone}</a><div class="socials"><a href={contact.instagram}>Instagram<Arrow /></a><a href={contact.tiktok}>TikTok<Arrow /></a></div></div>
  </div>
  <div class="footer-bottom metadata"><span>© {new Date().getFullYear()} Niyi.visuals</span><a href="#top">Back to top<Arrow direction="diagonal" /></a></div>
</footer>
<style>
  .site-footer { padding-top: 64px; padding-bottom: 24px; }
  .footer-main { display: grid; grid-template-columns: 4fr 2fr 2fr 4fr; gap: var(--grid-gap); padding-bottom: 64px; }
  .footer-name { font-size: 28px; line-height: 1.2; letter-spacing: -0.025em; text-decoration: none; }
  .footer-identity p { margin-top: 20px; font-size: 14px; color: var(--text-muted-dark); }
  nav, .footer-contact { display: flex; flex-direction: column; align-items: start; font-size: 15px; }
  nav a, .footer-contact > a { min-height: 44px; display: inline-flex; align-items: center; text-decoration: none; }
  nav a:hover, .footer-contact a:hover { text-decoration: underline; }
  .footer-contact > a:first-child { gap: 16px; }
  .socials { display: flex; gap: 24px; margin-top: 16px; }
  .socials a { display: inline-flex; gap: 8px; align-items: center; min-height: 44px; text-decoration: none; }
  .socials :global(svg) { width: 14px; height: 14px; }
  .footer-bottom { display: flex; align-items: center; justify-content: space-between; gap: 20px; border-top: 1px solid var(--rule-decorative); padding-top: 20px; }
  .footer-bottom a { min-height: 44px; display: inline-flex; align-items: center; gap: 20px; text-decoration: none; }
  .footer-bottom :global(svg) { transform: rotate(-45deg); width: 16px; }
  @media (max-width: 1023px) { .footer-main { grid-template-columns: 3fr 2fr 2fr; } .footer-contact { grid-column: 1 / -1; margin-top: 12px; } }
  @media (max-width: 600px) { .site-footer { padding-top: 48px; } .footer-main { grid-template-columns: 1fr 1fr; gap: 24px; padding-bottom: 40px; } .footer-identity { grid-column: 1 / -1; margin-bottom: 12px; } .footer-identity p { margin-top: 12px; } .footer-bottom { font-size: 10px; } }
</style>
