---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoFigure from '../components/PhotoFigure.astro';
import ActionLink from '../components/ActionLink.astro';
import CategoryFeature from '../components/CategoryFeature.astro';
import Arrow from '../components/Arrow.astro';
import { photos } from '../content/photos';
import { home } from '../content/home';
import { categories, routes } from '../content/site';
---
<BaseLayout title="Niyi Visuals — Sport, Event & Lifestyle Photography in Apeldoorn" description="Sport, parties and lifestyle photography by Niyi Scholten, based in Apeldoorn, The Netherlands. View the work and get in touch to discuss a shoot.">
  <section class="hero container" aria-labelledby="home-title">
    <div class="hero-context metadata"><span>Sport, parties &amp; lifestyle photography</span><span>Apeldoorn, The Netherlands</span></div>
    <div class="hero-composition">
      <h1 id="home-title" class="hero-title" aria-label={home.heading}><span>Where action</span>{" "}<span>meets emotion</span>{" "}<span class="quieter">every frame</span>{" "}<span class="quieter">tells a story</span></h1>
      <div class="hero-visual"><PhotoFigure photo={photos.celebration} eager sizes="(max-width: 767px) calc(100vw - 40px), (max-width: 1599px) 56vw, 840px" /><div class="hero-photo-caption metadata"><span>Sport / celebration</span><a href={routes.sport} aria-label="View Sport photography"><Arrow /></a></div></div>
      <div class="hero-details">
        <p class="hero-description">{home.supporting}</p>
        <div class="hero-actions"><ActionLink href={routes.work} variant="primary">View work</ActionLink><ActionLink href={routes.contact}>Let's connect</ActionLink></div>
      </div>
    </div>
    <div class="hero-baseline"><span class="metadata">Niyi Visuals</span><a href="#work" class="explore-link">Explore the work<Arrow direction="down" /></a></div>
  </section>

  <section id="work" class="work container" aria-labelledby="work-title">
    <div class="section-heading"><h2 id="work-title">My work</h2><ActionLink href={routes.work}>View all work</ActionLink></div>
    <div class="work-lead" data-feature-entrance>
      <div class="work-note"><p>Sport.<br />Parties.<br />Lifestyle.</p><span class="metadata">Action. Emotion.<br />Real moments.</span></div>
      <CategoryFeature name="Sport" href={routes.sport} photo={photos.sport} layout="lead" />
    </div>
    <div class="work-pair"><CategoryFeature name="Parties" href={routes.parties} photo={photos.parties} layout="wide" /><CategoryFeature name="Lifestyle" href={routes.lifestyle} photo={photos.lifestyle} layout="portrait" /></div>
  </section>

  <section id="about" class="about container" aria-labelledby="about-title">
    <div class="about-portrait"><PhotoFigure photo={photos.photographer} sizes="(max-width: 767px) calc(100vw - 40px), 38vw" caption="Niyi Scholten / Photography" /></div>
    <div class="about-copy"><h2 id="about-title">About me</h2><div class="biography">{home.introduction.map((paragraph, index) => <p class:list={[index === 0 && 'introduction']}>{paragraph}</p>)}</div><ActionLink href={routes.about}>More about me</ActionLink></div>
  </section>

  <section id="services" class="services container" aria-labelledby="services-title">
    <div class="services-heading"><h2 id="services-title">Services</h2><ActionLink href={routes.services}>Explore services</ActionLink></div>
    <div class="services-list">{categories.map(category => <a href={category.service} class="service-row"><h3>{category.name}</h3><p>{category.description}</p><span class="service-arrow"><Arrow /></span></a>)}</div>
  </section>

  <section class="inquiry" aria-labelledby="inquiry-title">
    <div class="inquiry-image container"><PhotoFigure photo={photos.running} sizes="(max-width: 1599px) calc(100vw - 40px), 1440px" /></div>
    <div class="inquiry-copy container"><h2 id="inquiry-title">Get in touch</h2><div><p>{home.invitation}</p><ActionLink href={routes.contact} variant="primary">Let's connect</ActionLink></div></div>
  </section>
</BaseLayout>
<style>
  .hero { padding-top: 28px; }
  .hero-context { display: flex; justify-content: space-between; gap: 24px; padding-bottom: 32px; }
  .hero-composition { display: grid; grid-template-columns: 5fr 7fr; gap: var(--grid-gap); align-items: center; row-gap: 0; }
  .hero-title { grid-column: 1; align-self: end; min-width: 0; padding-top: 8px; }
  .hero-details { grid-column: 1; align-self: start; padding-bottom: 20px; }
  .hero-title span { display: block; }
  .hero-title .quieter { color: var(--text-muted-dark); }
  .hero-description { margin-top: 28px; max-width: 39ch; font-size: 18px; line-height: 1.65; color: var(--text-muted-dark); }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 28px; margin-top: 28px; }
  .hero-visual { min-width: 0; grid-column: 2; grid-row: 1 / 3; }
  .hero-visual :global(.photo__frame) { aspect-ratio: 1.16; }
  .hero-photo-caption { display: flex; justify-content: space-between; align-items: center; margin-top: 8px; }
  .hero-photo-caption a { display: grid; place-items: center; width: 44px; height: 44px; }
  .hero-photo-caption :global(svg) { width: 16px; }
  .hero-baseline { margin-top: 24px; padding-bottom: 24px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--rule-decorative); }
  .explore-link { display: flex; align-items: center; gap: 28px; min-height: 48px; text-decoration: none; font-size: 13px; }
  .explore-link:hover { text-decoration: underline; }
  .explore-link :global(svg) { width: 16px; }
  .work { padding-top: var(--section-space); }
  .section-heading { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-bottom: 48px; }
  .work-lead { display: grid; grid-template-columns: 3fr 9fr; gap: var(--grid-gap); align-items: end; }
  .work-note { padding-bottom: 60px; }
  .work-note p { font-size: clamp(26px, 3vw, 44px); letter-spacing: -0.02em; line-height: 1.15; margin-bottom: 28px; }
  .work-pair { display: grid; grid-template-columns: 6fr 5fr; gap: clamp(40px, 9vw, 144px); align-items: start; padding-top: 72px; }
  .work-pair > :global(a:last-child) { margin-top: 128px; }
  .about { display: grid; grid-template-columns: 5fr 6fr; gap: clamp(48px, 8.4vw, 128px); align-items: center; padding-top: var(--section-space); padding-bottom: var(--section-space); }
  .about-portrait :global(.photo__frame) { aspect-ratio: 4 / 5; }
  .about-copy { max-width: 57ch; }
  .about-copy h2 { margin-bottom: 32px; }
  .biography p { margin-bottom: 20px; color: var(--text-muted-dark); font-size: 18px; line-height: 1.65; }
  .biography .introduction { color: var(--paper); font-size: clamp(24px, 2.2vw, 32px); line-height: 1.2; letter-spacing: -0.015em; margin-bottom: 24px; }
  .about-copy :global(.action) { margin-top: 4px; }
  .services { display: grid; grid-template-columns: 4fr 8fr; gap: var(--grid-gap); padding-block: 48px var(--section-space); border-top: 1px solid var(--rule-decorative); }
  .services-heading h2 { margin-bottom: 28px; }
  .service-row { display: grid; grid-template-columns: 3fr 5fr 44px; align-items: center; gap: 24px; min-height: 132px; padding-block: 26px; border-bottom: 1px solid var(--rule-decorative); text-decoration: none; }
  .service-row:first-child { padding-top: 0; min-height: 104px; }
  .service-row p { font-size: 18px; line-height: 1.6; color: var(--text-muted-dark); max-width: 25ch; }
  .service-arrow { display: grid; width: 44px; height: 44px; place-items: center; border: 1px solid var(--control-border-dark); border-radius: 2px; transition: color 160ms, background-color 160ms; }
  .service-row:hover .service-arrow { color: var(--ink); background: var(--paper); }
  .service-row:hover h3 { text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 1px; }
  .inquiry-image :global(.photo__frame) { aspect-ratio: 2.35; }
  .inquiry-copy { display: grid; grid-template-columns: 1fr 1fr; gap: var(--grid-gap); align-items: start; padding-block: 48px 64px; border-bottom: 1px solid var(--rule-decorative); }
  .inquiry-copy h2 { font-size: clamp(40px, 5vw, 72px); }
  .inquiry-copy p { max-width: 35ch; color: var(--text-muted-dark); font-size: 18px; line-height: 1.6; margin-bottom: 28px; }
  @media (min-width: 1600px) { .hero-composition { grid-template-columns: 5fr 7fr; } }
  @media (min-width: 768px) and (max-width: 1100px) { .hero-title { font-size: clamp(52px, 6.1vw, 68px); } .hero-composition { grid-template-columns: 1fr 1.05fr; } .hero-visual :global(.photo__frame) { aspect-ratio: 0.94; } .hero-description { font-size: 18px; } .hero-actions { gap: 12px; } .about { gap: 48px; } .services { grid-template-columns: 3fr 8fr; } .service-row { gap: 16px; } }
  @media (max-width: 767px) {
    .hero { padding-top: 20px; }
    .hero-context { display: block; font-size: 10px; padding-bottom: 24px; }
    .hero-context span { display: block; }
    .hero-context span + span { margin-top: 4px; }
    .hero-composition { display: flex; flex-direction: column; align-items: stretch; gap: 28px; }
    .hero-details { display: contents; }
    .hero-title { font-size: clamp(42px, 7.7vw, 58px); }
    .hero-title span { display: inline; }
    .hero-description { margin-top: 0; max-width: 45ch; font-size: 17px; }
    .hero-visual { }
    .hero-visual :global(.photo__frame) { aspect-ratio: 1.5; }
    .hero-actions { margin-top: -4px; gap: 16px; }
    .hero-photo-caption { margin-top: 0; font-size: 10px; }
    .hero-baseline { margin-top: 20px; padding-bottom: 16px; }
    .hero-baseline > span { display: none; }
    .hero-baseline .explore-link { width: 100%; justify-content: space-between; }
    .section-heading { align-items: center; margin-bottom: 28px; }
    .section-heading :global(.action) { gap: 14px; font-size: 14px; }
    .work-lead { display: block; }
    .work-note { display: none; }
    .work-pair { grid-template-columns: 1fr; gap: 40px; padding-top: 40px; }
    .work-pair > :global(a:last-child) { margin-top: 0; width: 86%; margin-left: auto; }
    .about { grid-template-columns: 1fr; gap: 32px; align-items: start; }
    .about-portrait { width: 80%; }
    .about-portrait :global(.photo__frame) { aspect-ratio: 4 / 5; }
    .about-copy h2 { margin-bottom: 24px; }
    .biography p { font-size: 17px; }
    .services { grid-template-columns: 1fr; gap: 24px; padding-top: 32px; }
    .services-heading { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
    .services-heading h2 { margin-bottom: 0; }
    .services-heading :global(.action) { font-size: 14px; gap: 14px; }
    .service-row { grid-template-columns: 1fr 44px; gap: 8px 20px; min-height: 0; padding-block: 24px; }
    .service-row:first-child { min-height: 0; padding-top: 8px; }
    .service-row h3 { grid-column: 1; }
    .service-row p { grid-column: 1; max-width: 26ch; font-size: 17px; }
    .service-arrow { grid-column: 2; grid-row: 1 / 3; }
    .inquiry-image :global(.photo__frame) { aspect-ratio: 1.5; }
    .inquiry-copy { grid-template-columns: 1fr; gap: 24px; padding-block: 32px 48px; }
    .inquiry-copy p { font-size: 17px; margin-bottom: 24px; max-width: 32ch; }
  }
  @media (max-width: 359px) { .hero-title { font-size: 40px; } .hero-actions { gap: 12px; } .hero-actions :global(.action) { gap: 14px; font-size: 14px; } .hero-actions :global(.action--primary) { padding-inline: 16px; } }
</style>
